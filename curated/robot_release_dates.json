{
  "_meta": {
    "title": "War Robots: Frontiers - War Robot release dates",
    "description": "First-availability dates for War Robots introduced during the full-launch era (March 4, 2025 onward). Derived by reading the official news archive (WRFrontiers-News-Scraper) and cross-referencing the datamined torso roster in this repo. Weapons are excluded; Titans are listed separately. Robots and titans are keyed by virtual_bot_ref (OBJID_VirtualBot::<slug>).",
    "release_date_definition": "The date a robot first became obtainable by players in the live game (patch/update/event launch day).",
    "pre_launch_meaning": "pre_launch=true means the robot existed before the full-launch era (carried over from 2022-2024 Early Access); it has no known launch-era release date (release_date is null).",
    "scope": "Robots present in the current datamined roster, plus any pending_roster entries.",
    "sources": {
      "news_archive": "WRFrontiers-News-Scraper (archive/), official warrobotsfrontiers.com/en/news; source_article_ids reference the article 'id' field",
      "datamined_roster": "WRFrontiersDB-Data current/Objects/VirtualBot.json (keys are its VirtualBot ids)",
      "patch_manifests": "curated/patch_manifests.json in this repo, keyed by manifest_id"
    },
    "generated": "2026-09-29",
    "robot_count": 37,
    "robots_with_known_date": 19,
    "titan_count": 5,
    "manifest_meaning": "manifest_id is the Steam depot build manifest for the maintenance deploy that shipped the robot; look it up in curated/patch_manifests.json for that build's version, buildid and exact UTC publish time. Where a patch day had a later same-day hotfix build, the earlier maintenance build is used.",
    "pending_roster_meaning": "pending_roster=true marks an entry recorded by hand (e.g. from the news) before the robot reached the datamined roster, keyed by its expected ref. The orchestrator RELEASES stage clears the flag and fills still-null release_date/manifest_id once the ref appears in the roster."
  },
