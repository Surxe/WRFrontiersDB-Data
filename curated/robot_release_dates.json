  "_meta": {
    "title": "War Robots: Frontiers - War Robot release dates",
    "description": "First-availability dates for War Robots introduced during the full-launch era (March 4, 2025 onward). Derived by reading the official news archive (WRFrontiers-News-Scraper) and cross-referencing the datamined torso roster in this repo. Weapons are excluded; Titans are listed separately.",
    "release_date_definition": "The date a robot first became obtainable by players in the live game (patch/update/event launch day).",
    "pre_launch_meaning": "pre_launch=true means the robot existed before the full-launch era (carried over from 2022-2024 Early Access); it has no known launch-era release date (release_date is null).",
    "scope": "Robots present in the current datamined roster, plus Angler (released 2026-09-15, not yet in the roster).",
    "sources": {
      "news_archive": "WRFrontiers-News-Scraper (archive/), official warrobotsfrontiers.com/en/news; source_article_ids reference the article 'id' field",
      "datamined_roster": "WRFrontiersDB-Data current/Objects/Module.json (VirtualBot ids; data version 2026-08-25)",
      "patch_manifests": "Steam depot build manifests for the War Robots: Frontiers app (matched to release_date by UTC calendar day)"
    },
    "generated": "2026-09-23",
    "robot_count": 37,
    "robots_with_known_date": 17,
    "titan_count": 5,
    "manifest_meaning": "manifest_id is the Steam depot build manifest for the maintenance deploy that shipped the robot; patch_released_at_utc is that build's exact publish time (UTC). Where a patch day had a later same-day hotfix build, the earlier maintenance build is used."
